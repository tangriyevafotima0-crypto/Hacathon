{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SKYFORGE Z01 import exchange v1",
  "description": "Shape contract; runtime additionally validates IDs, physical bounds, aliases, units, locations and source URLs.",
  "oneOf": [
    {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/row"
      }
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "rows"
      ],
      "properties": {
        "schema_version": {
          "const": "skyforge.atlas/1"
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/row"
          }
        }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "row": {
      "type": "object",
      "required": [
        "trial_id",
        "source_url"
      ],
      "anyOf": [
        {
          "required": [
            "study_id"
          ]
        },
        {
          "required": [
            "study"
          ]
        }
      ],
      "properties": {
        "study": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "material": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "sample_width_cm": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "sample_width_raw": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "flow_raw": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "oxygen_vol_pct": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "oxygen_raw": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "outcome": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "source_excerpt": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "document_id": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "table": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "row_id": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "study_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "trial_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "sample_width_status": {
          "enum": [
            "MEASURED",
            "NOT_PROVIDED",
            "NOT_EXTRACTED",
            "NOT_APPLICABLE",
            "CONFLICTING"
          ]
        },
        "flow_status": {
          "enum": [
            "MEASURED",
            "NOT_PROVIDED",
            "NOT_EXTRACTED",
            "NOT_APPLICABLE",
            "CONFLICTING"
          ]
        },
        "oxygen_status": {
          "enum": [
            "MEASURED",
            "NOT_PROVIDED",
            "NOT_EXTRACTED",
            "NOT_APPLICABLE",
            "CONFLICTING"
          ]
        },
        "sample_width_location": {
          "enum": [
            "chamber_atmosphere",
            "burner_flow",
            "sample_surface",
            "simulation_domain",
            "NOT_PROVIDED"
          ]
        },
        "flow_location": {
          "enum": [
            "chamber_atmosphere",
            "burner_flow",
            "sample_surface",
            "simulation_domain",
            "NOT_PROVIDED"
          ]
        },
        "oxygen_location": {
          "enum": [
            "chamber_atmosphere",
            "burner_flow",
            "sample_surface",
            "simulation_domain",
            "NOT_PROVIDED"
          ]
        },
        "sample_width_unit": {
          "enum": [
            "cm",
            "mm",
            "m"
          ]
        },
        "flow_unit": {
          "enum": [
            "cm/s",
            "m/s"
          ]
        },
        "oxygen_unit": {
          "enum": [
            "vol%",
            "mol/mol"
          ]
        },
        "sample_history": {
          "enum": [
            "NEW",
            "REUSED",
            "NOT_PROVIDED",
            "NOT_EXTRACTED",
            "NOT_APPLICABLE",
            "CONFLICTING"
          ]
        },
        "claim_type": {
          "enum": [
            "OBJECTIVE",
            "HYPOTHESIS",
            "OBSERVATION",
            "MODEL_RESULT",
            "CAVEAT"
          ]
        },
        "schema_version": {
          "const": "skyforge.atlas/1"
        },
        "pdf_page": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "pattern": "^(?:[1-9][0-9]*|)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "printed_page": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "pattern": "^(?:[1-9][0-9]*|)$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "propertyNames": {
        "not": {
          "enum": [
            "__proto__",
            "constructor",
            "prototype"
          ]
        }
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    }
  }
}
